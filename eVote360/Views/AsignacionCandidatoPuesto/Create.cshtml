@model eVote360.ViewModels.AsignacionCandidatoPuesto.AsignacionFormViewModel

@{
    ViewData["Title"] = "Asignar Candidato a Puesto";
}

<h2>Asignar Candidato a Puesto</h2>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label asp-for="EleccionId" class="form-label">
            Elección
        </label>

        <select asp-for="EleccionId"
                asp-items="Model.Elecciones"
                class="form-control">

            <option value="">
                Seleccione una elección
            </option>

        </select>
    </div>

    <div class="mb-3">
        <label asp-for="CandidatoId" class="form-label">
            Candidato
        </label>

        <select asp-for="CandidatoId"
                asp-items="Model.Candidatos"
                class="form-control">

            <option value="">
                Seleccione un candidato
            </option>

        </select>
    </div>

    <div class="mb-3">
        <label asp-for="PuestoElectivoId" class="form-label">
            Puesto Electivo
        </label>

        <select asp-for="PuestoElectivoId"
                asp-items="Model.PuestosElectivos"
                class="form-control">

            <option value="">
                Seleccione un puesto
            </option>

        </select>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Guardar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}