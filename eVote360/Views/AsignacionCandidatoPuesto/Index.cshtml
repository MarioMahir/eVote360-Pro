@using eVote360.Core.Entities

@model IEnumerable<AsignacionCandidatoPuesto>

@{
    ViewData["Title"] = "Asignaciones";
}

<h2>Asignaciones de Candidatos</h2>

<a asp-action="Create"
   class="btn btn-success mb-3">
    Nueva Asignación
</a>

<table class="table table-bordered">

    <thead>

        <tr>

            <th>Elección</th>

            <th>Candidato</th>

            <th>Puesto Electivo</th>

            <th>Fecha</th>

            <th>Estado</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.Eleccion.Nombre
                </td>

                <td>
                    @item.Candidato.Nombre
                    @item.Candidato.Apellido
                </td>

                <td>
                    @item.PuestoElectivo.Nombre
                </td>

                <td>
                    @item.FechaAsignacion.ToShortDateString()
                </td>

                <td>

                    @if (item.Activo)
                    {
                        <span class="badge bg-success">
                            Activo
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Inactivo
                        </span>
                    }

                </td>

            </tr>
        }

    </tbody>

</table>
