@model eVote360.Core.DTOs.Auth.LoginDto

<h2>Iniciar sesión</h2>

<form asp-action="Login" method="post">

    <div>
        <label>Usuario</label>
        <input asp-for="NombreUsuario" />
        <span asp-validation-for="NombreUsuario"></span>
    </div>

    <div>
        <label>Contraseña</label>
        <input asp-for="Contrasena" type="password" />
        <span asp-validation-for="Contrasena"></span>
    </div>

    <button type="submit">
        Acceder
    </button>

</form>

<div asp-validation-summary="All"></div>