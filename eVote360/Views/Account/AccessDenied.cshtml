@{
    ViewData["Title"] = "Acceso denegado";
    var esAdmin = User.IsInRole(Roles.Administrador);
    var home = esAdmin ? "HomeAdmin" : "HomeDirigente";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center py-5">
        <div class="display-5 text-danger mb-2">⛔</div>
        <h1 class="h4">No posee permisos para acceder a esta sección.</h1>
        <p class="text-muted">Esta sección está reservada para otro rol del sistema.</p>
        <a asp-controller="@home" asp-action="Index" class="btn btn-primary">
            Ir al Home del @(esAdmin ? "administrador" : "dirigente")
        </a>
    </div>
</div>
