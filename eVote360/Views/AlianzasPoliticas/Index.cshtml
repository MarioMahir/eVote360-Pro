@using eVote360.Core.Entities
@model IEnumerable<eVote360.Core.Entities.AlianzaPolitica>

<h2>Alianzas Políticas</h2>

<a asp-action="Create"
   class="btn btn-success mb-3">
    Nueva Alianza
</a>

<table class="table table-striped">

    <thead>
        <tr>
            <th>Solicitante</th>
            <th>Aliado</th>
            <th>Estado</th>
            <th>Fecha</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.PartidoSolicitante.Nombre</td>

                <td>@item.PartidoAliado.Nombre</td>

                <td>@item.Estado</td>

                <td>@item.FechaSolicitud.ToShortDateString()</td>

                <td>

                    @if (item.Estado == EstadoAlianza.Pendiente)
                    {
                        <a asp-action="Aceptar"
                           asp-route-id="@item.Id"
                           class="btn btn-success btn-sm">
                            Aceptar
                        </a>

                        <a asp-action="Rechazar"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Rechazar
                        </a>
                    }

                </td>

            </tr>
        }

    </tbody>

</table>