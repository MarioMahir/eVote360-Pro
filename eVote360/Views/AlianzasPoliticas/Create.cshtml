@using eVote360.Core.Entities
@model eVote360.ViewModels.AlianzaPolitica.CreateAlianzaViewModel

@{
    ViewData["Title"] = "Crear Alianza";
}

<h2>Crear Alianza Política</h2>

<form asp-action="Create">

    <div class="mb-3">
        <label class="form-label">Partido aliado</label>

        <select asp-for="PartidoAliadoId" class="form-control">
            <option value="">Seleccione</option>

            @foreach (var partido in ViewBag.Partidos)
            {
                <option value="@partido.Id">
                    @partido.Nombre
                </option>
            }
        </select>

        <span asp-validation-for="PartidoAliadoId"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>

</form>