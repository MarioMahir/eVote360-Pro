@model List<eVote360.Core.Entities.PuestoElectivo>
@{
    ViewData["Title"] = "Puestos electivos";
    bool bloqueado = ViewBag.ExisteEleccionActiva ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Mantenimiento de puestos electivos</h1>
    @if (bloqueado)
    {
        <button class="btn btn-secondary" disabled>Crear puesto electivo</button>
    }
    else
    {
        <a asp-action="Create" class="btn btn-primary">Crear puesto electivo</a>
    }
</div>

<partial name="_BloqueoEleccionActiva" model="@("No se pueden modificar puestos electivos mientras exista una elección activa.")" />

<div class="table-responsive">
    <table class="table table-striped align-middle bg-white shadow-sm">
        <thead class="table-light">
            <tr>
                <th>Nombre del puesto</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th class="text-end" style="width:220px">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-4">No existen puestos electivos registrados.</td></tr>
            }
            @foreach (var p in Model)
            {
                <tr>
                    <td class="fw-semibold">@p.Nombre</td>
                    <td class="text-muted">@p.Descripcion</td>
                    <td><partial name="_EstadoBadge" model="p.Activo" /></td>
                    <td class="text-end">
                        @if (bloqueado)
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled>Editar</button>
                            <button class="btn btn-sm btn-outline-secondary" disabled>@(p.Activo ? "Desactivar" : "Activar")</button>
                        }
                        else
                        {
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (p.Activo)
                            {
                                <a asp-action="Desactivar" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Desactivar</a>
                            }
                            else
                            {
                                <a asp-action="Activar" asp-route-id="@p.Id" class="btn btn-sm btn-outline-success">Activar</a>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
