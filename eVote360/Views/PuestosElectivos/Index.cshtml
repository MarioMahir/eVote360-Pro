@model IEnumerable<eVote360.Core.Entities.PuestoElectivo>

@{
    ViewData["Title"] = "Puestos Electivos";
}

<h2>Puestos Electivos</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Crear puesto electivo
</a>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th width="250"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var puesto in Model)
        {
            <tr>
                <td>@puesto.Nombre</td>
                <td>@puesto.Descripcion</td>
                <td>
                    @(puesto.Activo ? "Activo" : "Inactivo")
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@puesto.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    @if (puesto.Activo)
                    {
                        <a asp-action="Desactivar"
                           asp-route-id="@puesto.Id"
                           class="btn btn-danger btn-sm">
                            Desactivar
                        </a>
                    }
                    else
                    {
                        <a asp-action="Activar"
                           asp-route-id="@puesto.Id"
                           class="btn btn-success btn-sm">
                            Activar
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>