@model List<eVote360.Core.Entities.Usuario>
@{
    ViewData["Title"] = "Usuarios";
    bool bloqueado = ViewBag.ExisteEleccionActiva ?? false;
    int actual = ViewBag.UsuarioActualId ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Mantenimiento de usuarios</h1>
    @if (bloqueado)
    {
        <button class="btn btn-secondary" disabled>Crear usuario</button>
    }
    else
    {
        <a asp-action="Create" class="btn btn-primary">Crear usuario</a>
    }
</div>

<partial name="_BloqueoEleccionActiva" model="@("No se pueden modificar usuarios mientras exista una elección activa.")" />

<div class="table-responsive">
    <table class="table table-striped align-middle bg-white shadow-sm">
        <thead class="table-light">
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Correo electrónico</th>
                <th>Nombre de usuario</th>
                <th>Rol</th>
                <th>Estado</th>
                <th class="text-end" style="width:220px">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Nombre</td>
                    <td>@u.Apellido</td>
                    <td>@u.CorreoElectronico</td>
                    <td><code>@u.NombreUsuario</code> @(u.Id == actual ? Html.Raw("<span class=\"badge bg-info text-dark\">Usted</span>") : null)</td>
                    <td>@u.Rol</td>
                    <td><partial name="_EstadoBadge" model="u.Activo" /></td>
                    <td class="text-end">
                        @if (bloqueado)
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled>Editar</button>
                            <button class="btn btn-sm btn-outline-secondary" disabled>@(u.Activo ? "Desactivar" : "Activar")</button>
                        }
                        else
                        {
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (u.Activo)
                            {
                                <a asp-action="Desactivar" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger">Desactivar</a>
                            }
                            else
                            {
                                <a asp-action="Activar" asp-route-id="@u.Id" class="btn btn-sm btn-outline-success">Activar</a>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
