@model eVote360.Core.DTOs.Candidatos.CandidatoUpdateDto
@{
    ViewData["Title"] = "Editar candidato";
    bool bloqueado = ViewBag.DatosBloqueados ?? false;
}
<div class="row justify-content-center"><div class="col-lg-6"><div class="card shadow-sm"><div class="card-body p-4">
    <h1 class="h4 mb-3">Editar candidato</h1>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="FotoActual" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        @if (bloqueado)
        {
            <div class="alert alert-warning small">No se pueden modificar los datos principales de este candidato porque ya participó en una elección. Solo puede cambiar el estado.</div>
        }

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Nombre" class="form-label">Nombre del candidato</label>
                <input asp-for="Nombre" class="form-control" readonly="@bloqueado" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Apellido" class="form-label">Apellido del candidato</label>
                <input asp-for="Apellido" class="form-control" readonly="@bloqueado" />
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 d-flex gap-3 align-items-center">
            <img src="@Model.FotoActual" alt="Foto actual" class="foto-candidato" />
            <div class="flex-grow-1">
                <label asp-for="Foto" class="form-label">Nueva foto (opcional)</label>
                <input asp-for="Foto" type="file" accept=".jpg,.jpeg,.png" class="form-control" disabled="@bloqueado" />
                <span asp-validation-for="Foto" class="text-danger"></span>
            </div>
        </div>

        <div class="form-check mb-3">
            <input asp-for="Activo" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label">Activo</label>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Volver atrás</a>
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </div>
    </form>
</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
