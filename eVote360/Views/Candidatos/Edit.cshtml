@model eVote360.Core.DTOs.Candidatos.CandidatoUpdateDto

@{
    ViewData["Title"] = "Editar candidato";
}

<h2>Editar candidato</h2>

<form asp-action="Edit"
      enctype="multipart/form-data">

    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Apellido"></label>
        <input asp-for="Apellido"
               class="form-control" />
    </div>

    <div class="mb-3">
        <img src="@ViewBag.FotoActual"
             width="120"
             class="mb-2" />

        <input asp-for="Foto"
               type="file"
               class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="Activo"
               class="form-check-input" />
        <label asp-for="Activo"
               class="form-check-label"></label>
    </div>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver atrás
    </a>

    <button type="submit"
            class="btn btn-primary">
        Guardar cambios
    </button>

</form>