@model IEnumerable<eVote360.Core.Entities.Candidato>

@{
    ViewData["Title"] = "Candidatos";
}

<div class="d-flex justify-content-between mb-3">
    <h2>Candidatos</h2>

    <a asp-action="Create"
       class="btn btn-primary">
        Crear candidato
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Foto</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Puesto</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <td>
                    <img src="@item.FotoUrl"
                         width="80"
                         height="80"
                         style="object-fit:cover;" />
                </td>

                <td>@item.Nombre</td>

                <td>@item.Apellido</td>

                <td>
                    @(item.PuestoElectivo?.Nombre
                                    ?? "Sin puesto asociado")
                                                         </td>

                <td>
                    @(item.Activo
                                    ? "Activo"
                                    : "Inactivo")
            </td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                @if (item.Activo)
                    {
                        <a asp-action="Desactivar"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Desactivar
                        </a>
                    }
                    else
                    {
                        <a asp-action="Activar"
                           asp-route-id="@item.Id"
                           class="btn btn-success btn-sm">
                            Activar
                        </a>
                    }

                </td>

            </tr>
        }
    </tbody>
</table>