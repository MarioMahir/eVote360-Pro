@model List<eVote360.Core.DTOs.Asignaciones.CandidatoListDto>
@{
    ViewData["Title"] = "Candidatos";
    bool bloqueado = ViewBag.ExisteEleccionActiva ?? false;
    var partido = (eVote360.Core.Entities.PartidoPolitico)ViewBag.Partido;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Candidatos</h1>
        <small class="text-muted">@partido.Nombre (@partido.Siglas)</small>
    </div>
    @if (bloqueado)
    {
        <button class="btn btn-secondary" disabled>Crear candidato</button>
    }
    else
    {
        <a asp-action="Create" class="btn btn-primary">Crear candidato</a>
    }
</div>

<partial name="_BloqueoEleccionActiva" model="@("No se pueden modificar candidatos mientras exista una elección activa.")" />

<div class="table-responsive">
    <table class="table table-striped align-middle bg-white shadow-sm">
        <thead class="table-light">
            <tr>
                <th style="width:70px">Foto</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Puesto electivo asociado</th>
                <th>Estado</th>
                <th class="text-end" style="width:220px">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No existen candidatos registrados para su partido.</td></tr>
            }
            @foreach (var c in Model)
            {
                <tr>
                    <td><img src="@c.FotoUrl" alt="Foto de @c.Nombre" class="foto-candidato-sm" /></td>
                    <td>@c.Nombre</td>
                    <td>@c.Apellido</td>
                    <td>
                        @if (c.PuestoAsociado != null) { <span class="badge bg-primary">@c.PuestoAsociado</span> }
                        else { <span class="text-muted">Sin puesto asociado</span> }
                    </td>
                    <td><partial name="_EstadoBadge" model="c.Activo" /></td>
                    <td class="text-end">
                        @if (bloqueado)
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled>Editar</button>
                            <button class="btn btn-sm btn-outline-secondary" disabled>@(c.Activo ? "Desactivar" : "Activar")</button>
                        }
                        else
                        {
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (c.Activo)
                            {
                                <a asp-action="Desactivar" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">Desactivar</a>
                            }
                            else
                            {
                                <a asp-action="Activar" asp-route-id="@c.Id" class="btn btn-sm btn-outline-success">Activar</a>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
