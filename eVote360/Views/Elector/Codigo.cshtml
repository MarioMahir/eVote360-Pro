@model eVote360.ViewModels.Elector.CodigoViewModel
@{
    ViewData["Title"] = "Código de verificación";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <partial name="_Pasos" model="3" />

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-2">Código de verificación</h1>
                <p class="text-muted">Enviamos un código de 6 dígitos a <strong>@Model.CorreoOculto</strong>. Tiene una vigencia de 5 minutos y solo puede usarse una vez.</p>

                <form asp-action="Codigo" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Codigo" class="form-label"></label>
                        <input asp-for="Codigo" class="form-control form-control-lg text-center codigo" maxlength="6" inputmode="numeric" autocomplete="one-time-code" placeholder="000000" autofocus />
                        <span asp-validation-for="Codigo" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Cancelar" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Validar código</button>
                    </div>
                </form>

                <form asp-action="ReenviarCodigo" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-link btn-sm p-0">¿No recibió el código? Solicitar uno nuevo</button>
                </form>
            </div>
        </div>
    </div>
</div>
