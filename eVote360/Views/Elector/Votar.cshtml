@model eVote360.ViewModels.Elector.VotoPuestoViewModel
@{
    ViewData["Title"] = "Votar por " + Model.PuestoNombre;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <partial name="_Pasos" model="4" />

        <h1 class="h4 mb-1">@Model.PuestoNombre</h1>
        <p class="text-muted">Seleccione un candidato o la opción <strong>Ninguno</strong>.</p>

        <form asp-action="Votar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PuestoElectivoId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                @foreach (var o in Model.Opciones)
                {
                    var id = $"cand-{o.CandidatoId}";
                    <div class="col-md-6">
                        <input type="radio" class="btn-check" name="CandidatoSeleccionado" id="@id" value="@o.CandidatoId"
                               @(Model.CandidatoSeleccionado == o.CandidatoId ? "checked" : "") />
                        <label class="opcion-voto card h-100" for="@id">
                            <div class="card-body d-flex align-items-center gap-3">
                                <img src="@o.FotoUrl" alt="Foto de @o.Nombre" class="foto-candidato" />
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@o.Nombre</div>
                                    <div class="small text-muted">@o.PartidoNombre (@o.PartidoSiglas)</div>
                                </div>
                                <img src="@o.LogoUrl" alt="Logo de @o.PartidoSiglas" class="logo-partido" />
                            </div>
                        </label>
                    </div>
                }
                <div class="col-md-6">
                    <input type="radio" class="btn-check" name="CandidatoSeleccionado" id="cand-ninguno" value="0"
                           @(Model.CandidatoSeleccionado == 0 ? "checked" : "") />
                    <label class="opcion-voto card h-100" for="cand-ninguno">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="foto-candidato d-flex align-items-center justify-content-center bg-light text-muted fs-3">∅</div>
                            <div>
                                <div class="fw-semibold">Ninguno</div>
                                <div class="small text-muted">No votar por ningún candidato para este puesto</div>
                            </div>
                        </div>
                    </label>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Puestos" class="btn btn-outline-secondary">Volver a los puestos</a>
                <button type="submit" class="btn btn-primary">Guardar voto del puesto</button>
            </div>
        </form>
    </div>
</div>
