@model eVote360.Core.Entities.DirigentePolitico

@{
    ViewData["Title"] = "Eliminar asignación";
}

<h2>Eliminar asignación</h2>

<div class="alert alert-warning">

    <p>
        ¿Está seguro que desea desvincular este dirigente político de este partido?
    </p>

    <hr />

    <strong>Dirigente:</strong>
    @Model.Usuario.Nombre
    @Model.Usuario.Apellido

    <br />

    <strong>Partido:</strong>
    @Model.PartidoPolitico.Nombre

</div>

<form asp-action="ConfirmDelete">

    <input type="hidden"
           asp-for="Id" />

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

    <button type="submit"
            class="btn btn-danger">
        Aceptar
    </button>

</form>