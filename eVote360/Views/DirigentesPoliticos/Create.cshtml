@model eVote360.Core.DTOs.DirigentesPoliticos.DirigentePoliticoCreateDto

@{
    ViewData["Title"] = "Agregar asignación";
}

<h2>Agregar asignación</h2>

<form asp-action="Create">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label asp-for="UsuarioId"
               class="form-label">
            Dirigente político
        </label>

        <select asp-for="UsuarioId"
                asp-items="ViewBag.Dirigentes"
                class="form-select">
            <option value="">
                Seleccione un dirigente
            </option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="PartidoPoliticoId"
               class="form-label">
            Partido político
        </label>

        <select asp-for="PartidoPoliticoId"
                asp-items="ViewBag.Partidos"
                class="form-select">
            <option value="">
                Seleccione un partido
            </option>
        </select>
    </div>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver atrás
    </a>

    <button type="submit"
            class="btn btn-primary">
        Crear asignación
    </button>

</form>