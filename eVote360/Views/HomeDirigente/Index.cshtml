<h1>Panel del Dirigente Político</h1>

<p>
    Bienvenido @User.Identity!.Name
</p>

<h3>Funcionalidades del Dirigente Político</h3>

<ul>

    <li>
        <a asp-controller="Candidatos"
           asp-action="Index">
            Gestionar Candidatos
        </a>
    </li>

    <li>
        Solicitar Alianzas Políticas
    </li>

    <li>
        Aceptar Alianzas Políticas
    </li>

    <li>
        Rechazar Alianzas Políticas
    </li>

    <li>
        Asignar Candidatos a Puestos Electivos
    </li>

    <li>
        Consultar Información de su Partido
    </li>

</ul>

<a asp-controller="Account"
   asp-action="Logout">
    Cerrar sesión
</a>