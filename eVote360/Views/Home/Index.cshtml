@{
    ViewData["Title"] = "eVote360";
}

<h1>eVote360</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<h3>Funcionalidades del Elector</h3>

<ul>
    <li>Validar identidad mediante número de documento.</li>
    <li>Verificar identidad con la cédula.</li>
    <li>Recibir código de verificación por correo electrónico.</li>
    <li>Validar código de seguridad.</li>
    <li>Consultar boleta electoral.</li>
    <li>Seleccionar candidatos.</li>
    <li>Confirmar votación.</li>
    <li>Finalizar proceso de votación.</li>
    <li>Recibir resumen de votación.</li>
</ul>

<hr />

<form method="post" asp-controller="Ciudadanos" asp-action="IniciarVotacion">
    <div class="mb-3">
        <label class="form-label">Número de documento de identidad</label>
        <input type="text"
               name="numeroDocumento"
               class="form-control"
               placeholder="Ej. 402..."
               required />
    </div>

    <button type="submit" class="btn btn-success">
        Iniciar Votación
    </button>
</form>

<hr />

<a asp-controller="Account"
   asp-action="Login"
   class="btn btn-primary">
    Acceder como Personal
</a>