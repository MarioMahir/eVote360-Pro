@model List<eVote360.Core.DTOs.Elecciones.ResultadoPuestoDto>
@{
    var eleccion = (eVote360.Core.Entities.Eleccion)ViewBag.Eleccion;
    ViewData["Title"] = "Resultados: " + eleccion.Nombre;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Resultados</h1>
        <div class="text-muted">@eleccion.Nombre · @eleccion.FechaEleccion.ToString("dd/MM/yyyy") · <span class="badge bg-secondary">Finalizada</span></div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver atrás</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Esta elección no tiene puestos registrados.</div>
}

@foreach (var puesto in Model)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center bg-white">
            <h2 class="h5 mb-0">@puesto.PuestoNombre</h2>
            <span class="text-muted small">@puesto.TotalVotos.ToString("N0") votos emitidos</span>
        </div>
        <div class="card-body p-0">
            @if (puesto.Empate)
            {
                <div class="alert alert-warning rounded-0 mb-0">Existe un empate en el primer lugar para este puesto electivo.</div>
            }
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:60px"></th>
                        <th>Candidato / opción</th>
                        <th>Partido político</th>
                        <th class="text-end">Votos</th>
                        <th style="width:28%">Porcentaje</th>
                        <th>Resultado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in puesto.Opciones)
                    {
                        <tr class="@(o.Ganador ? "table-success" : o.EmpatePrimerLugar ? "table-warning" : "")">
                            <td>
                                @if (o.FotoUrl != null)
                                {
                                    <img src="@o.FotoUrl" alt="" class="foto-candidato-sm" />
                                }
                            </td>
                            <td class="fw-semibold">@o.Candidato</td>
                            <td>
                                @if (o.LogoUrl != null)
                                {
                                    <img src="@o.LogoUrl" alt="" class="logo-partido-sm me-1" />
                                }
                                @o.Partido
                            </td>
                            <td class="text-end">@o.Votos.ToString("N0")</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:10px">
                                        <div class="progress-bar @(o.Ganador ? "bg-success" : "")" role="progressbar" style="width:@(o.Porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                    </div>
                                    <span class="small">@o.Porcentaje.ToString("0.##")%</span>
                                </div>
                            </td>
                            <td>
                                @if (o.Ganador) { <span class="badge bg-success">Ganador</span> }
                                else if (o.EmpatePrimerLugar) { <span class="badge bg-warning text-dark">Empate</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
