@model eVote360.ViewModels.Admin.PartidoPoliticoViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="LogoActual" />
<input type="hidden" asp-for="DatosBloqueados" />

@if (Model.DatosBloqueados)
{
    <div class="alert alert-warning small">No se pueden modificar el nombre, las siglas ni el logo de este partido político porque ya participó en una elección. Sí puede cambiar la descripción y el estado.</div>
}

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" readonly="@Model.DatosBloqueados" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Siglas" class="form-label"></label>
        <input asp-for="Siglas" class="form-control text-uppercase" readonly="@Model.DatosBloqueados" placeholder="Ej: PND" />
        <span asp-validation-for="Siglas" class="text-danger"></span>
    </div>
    <div class="col-md-8 mb-3">
        <label asp-for="Logo" class="form-label"></label>
        <input asp-for="Logo" type="file" accept=".jpg,.jpeg,.png" class="form-control" disabled="@Model.DatosBloqueados" />
        <span asp-validation-for="Logo" class="text-danger"></span>
        @if (Model.Id > 0 && !Model.DatosBloqueados)
        {
            <div class="form-text">Opcional en edición: si no carga una imagen se conserva el logo actual.</div>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.LogoActual))
{
    <div class="mb-3">
        <div class="form-label">Logo actual</div>
        <img src="@Model.LogoActual" alt="Logo actual" class="logo-partido-grande border rounded" />
    </div>
}

<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>

<div class="form-check mb-3">
    <input asp-for="Activo" class="form-check-input" />
    <label asp-for="Activo" class="form-check-label"></label>
</div>
