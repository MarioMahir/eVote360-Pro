@model IEnumerable<eVote360.Core.Entities.PartidoPolitico>

@{
    ViewData["Title"] = "Partidos Políticos";
}

<h2>Partidos Políticos</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Crear Partido Político
    </a>
</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Logo</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Siglas</th>
            <th>Estado</th>
            <th width="220">Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var partido in Model)
        {
            <tr>
                <td>
                    <img src="@partido.LogoUrl"
                         width="80"
                         height="80"
                         style="object-fit:contain;" />
                </td>

                <td>@partido.Nombre</td>

                <td>@partido.Descripcion</td>

                <td>@partido.Siglas</td>

                <td>
                    @(partido.Activo ? "Activo" : "Inactivo")
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@partido.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    @if (partido.Activo)
                    {
                        <a asp-action="Desactivar"
                           asp-route-id="@partido.Id"
                           class="btn btn-danger btn-sm">
                            Desactivar
                        </a>
                    }
                    else
                    {
                        <a asp-action="Activar"
                           asp-route-id="@partido.Id"
                           class="btn btn-success btn-sm">
                            Activar
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>