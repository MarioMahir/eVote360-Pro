@model eVote360.Core.Entities.PartidoPolitico

@{
    ViewData["Title"] = "Editar Partido Político";
}

<h2>Editar Partido Político</h2>

<form asp-action="Edit"
      method="post"
      enctype="multipart/form-data">

    <input asp-for="Id" type="hidden" />
    <input asp-for="LogoUrl" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion"
                  class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Siglas" class="form-label"></label>
        <input asp-for="Siglas" class="form-control" />
        <span asp-validation-for="Siglas" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <p>Logo actual:</p>

        <img src="@Model.LogoUrl"
             width="120"
             height="120"
             style="object-fit:contain;" />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Nuevo logo (opcional)
        </label>

        <input type="file"
               name="logo"
               class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="Activo"
               class="form-check-input" />

        <label asp-for="Activo"
               class="form-check-label">
            Activo
        </label>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Guardar Cambios
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver atrás
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}