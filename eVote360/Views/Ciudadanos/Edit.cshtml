@model eVote360.ViewModels.Admin.CiudadanoViewModel
@{
    ViewData["Title"] = "Editar ciudadano";
}
<div class="row justify-content-center"><div class="col-lg-7"><div class="card shadow-sm"><div class="card-body p-4">
    <h1 class="h4 mb-3">Editar ciudadano</h1>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <partial name="_Form" model="Model" />
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Volver atrás</a>
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </div>
    </form>
</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
