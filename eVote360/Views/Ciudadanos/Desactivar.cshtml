@model eVote360.Core.Entities.Ciudadano

<h2>Desactivar ciudadano</h2>

<div class="alert alert-danger">
    ¿Está seguro que desea desactivar este ciudadano?
</div>

<p>
    <strong>@Model.Nombre @Model.Apellido</strong>
</p>

<form asp-action="DesactivarConfirmado" method="post">

    <input type="hidden" asp-for="Id" />

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>

    <button type="submit" class="btn btn-danger">
        Aceptar
    </button>

</form>